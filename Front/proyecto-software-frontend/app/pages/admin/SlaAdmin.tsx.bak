import { useEffect, useState } from "react";

export default function SlaAdmin() {
  const [reglas, setReglas] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    const fetchReglas = async () => {
      const token = localStorage.getItem('auth_token');
      
      if (!token) {
        setError("No hay sesión activa");
        setIsLoading(false);
        return;
      }
      
      try {
        const response = await fetch(`http://localhost:8080/api/sla`, {
          headers: { 
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
        });
        
        if (response.ok) {
          const data = await response.json();
          setReglas(data?.data || []);
        } else {
          setError("Error al cargar las reglas SLA");
        }
      } catch (error) {
        setError("Error de conexión");
      } finally {
        setIsLoading(false);
      }
    };
    
    fetchReglas();
  }, []);

  if (isLoading) {
    return <div className="h-96 bg-zinc-100 rounded-xl animate-pulse" />;
  }

  if (error) {
    return (
      <div className="rounded-xl bg-red-50 border border-red-200 p-6 text-center">
        <p className="text-red-700">{error}</p>
        <button 
          onClick={() => window.location.reload()}
          className="mt-4 px-4 py-2 bg-primary text-white rounded-lg"
        >
          Reintentar
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-zinc-900">SLA y Reglas</h1>
        <p className="text-sm text-zinc-500 mt-1">
          Administra las reglas de nivel de servicio (SLA)
        </p>
      </div>

      {reglas.length === 0 ? (
        <div className="rounded-xl bg-yellow-50 border border-yellow-200 p-6 text-center">
          <p className="text-yellow-700">No hay reglas SLA configuradas.</p>
        </div>
      ) : (
        <div className="rounded-xl bg-white border border-zinc-200 shadow-sm overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="text-[11px] uppercase tracking-wider text-zinc-400 bg-zinc-50">
                  <th className="px-5 py-3 text-left">ID</th>
                  <th className="px-5 py-3 text-left">Nombre</th>
                  <th className="px-5 py-3 text-left">Prioridad</th>
                  <th className="px-5 py-3 text-left">Respuesta (horas)</th>
                  <th className="px-5 py-3 text-left">Resolución (horas)</th>
                  <th className="px-5 py-3 text-left">Aplica a</th>
                  <th className="px-5 py-3 text-left">Estado</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-zinc-100">
                {reglas.map((regla) => (
                  <tr key={regla.id} className="hover:bg-zinc-50 transition">
                    <td className="px-5 py-3 text-zinc-600">{regla.id}</td>
                    <td className="px-5 py-3 font-medium text-zinc-900">{regla.nombre}</td>
                    <td className="px-5 py-3">
                      <span className={`px-2 py-1 rounded-full text-[10px] font-bold ${
                        regla.prioridad === 'alta' ? 'bg-red-100 text-red-800' :
                        regla.prioridad === 'media' ? 'bg-yellow-100 text-yellow-800' :
                        'bg-green-100 text-green-800'
                      }`}>
                        {regla.prioridad?.toUpperCase()}
                      </span>
                    </td>
                    <td className="px-5 py-3 text-zinc-600">{regla.tiempoRespuestaHoras}h</td>
                    <td className="px-5 py-3 text-zinc-600">{regla.tiempoResolucionHoras}h</td>
                    <td className="px-5 py-3 text-zinc-600">
                      {regla.aplicaRolNombre || "Todos"}
                    </td>
                    <td className="px-5 py-3">
                      <span className={`px-2 py-1 rounded-full text-[10px] font-bold ${
                        regla.activo ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'
                      }`}>
                        {regla.activo ? "ACTIVO" : "INACTIVO"}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  );
}