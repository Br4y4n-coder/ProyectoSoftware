import { useEffect, useState } from "react";
import { Search } from "lucide-react";

export default function AuditoriaAdmin() {
  const [logs, setLogs] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [tipoFilter, setTipoFilter] = useState("todos");

  const fetchLogs = async () => {
    const token = localStorage.getItem('auth_token');
    
    if (!token) {
      setError("No hay sesión activa");
      setIsLoading(false);
      return;
    }
    
    try {
      let url = `http://localhost:8080/api/auditoria?page=0&size=100`;
      
      if (search && tipoFilter === "usuario") {
        url = `http://localhost:8080/api/auditoria/buscar/usuario?usuario=${search}&page=0&size=100`;
      } else if (search && tipoFilter === "accion") {
        url = `http://localhost:8080/api/auditoria/buscar/accion?accion=${search}&page=0&size=100`;
      }
      
      const response = await fetch(url, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (response.ok) {
        const data = await response.json();
        setLogs(data?.data?.content || []);
      } else {
        setError("Error al cargar auditoría");
      }
    } catch (error) {
      setError("Error de conexión");
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchLogs();
  }, []);

  const handleSearch = () => {
    setIsLoading(true);
    fetchLogs();
  };

  if (isLoading) {
    return <div className="h-96 bg-zinc-100 rounded-xl animate-pulse" />;
  }

  if (error) {
    return (
      <div className="rounded-xl bg-red-50 border border-red-200 p-6 text-center">
        <p className="text-red-700">{error}</p>
        <button 
          onClick={() => window.location.reload()}
          className="mt-4 px-4 py-2 bg-primary text-white rounded-lg"
        >
          Reintentar
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-zinc-900">Auditoría</h1>
        <p className="text-sm text-zinc-500 mt-1">
          Registro de actividades del sistema
        </p>
      </div>

      <div className="flex flex-col sm:flex-row gap-3">
        <div className="flex-1 flex items-center gap-2 h-10 px-3 rounded-lg bg-white border border-zinc-200">
          <Search className="w-4 h-4 text-zinc-400" />
          <input
            type="search"
            placeholder="Buscar..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="flex-1 text-sm outline-none bg-transparent"
          />
          <button
            onClick={handleSearch}
            className="px-3 py-1 rounded-lg bg-primary text-white text-sm"
          >
            Buscar
          </button>
        </div>
        <select
          value={tipoFilter}
          onChange={(e) => setTipoFilter(e.target.value)}
          className="h-10 px-3 rounded-lg border border-zinc-200 text-sm bg-white"
        >
          <option value="todos">Todos</option>
          <option value="usuario">Buscar por usuario</option>
          <option value="accion">Buscar por acción</option>
        </select>
        <button
          onClick={() => {
            setSearch("");
            setTipoFilter("todos");
            fetchLogs();
          }}
          className="px-4 py-2 rounded-lg border border-zinc-200 text-zinc-600 hover:bg-zinc-50 transition"
        >
          Limpiar
        </button>
      </div>

      <div className="space-y-3">
        {logs.map((log) => (
          <div key={log.id} className="rounded-xl bg-white border border-zinc-200 p-4 hover:shadow-sm transition">
            <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
              <span className="font-semibold text-zinc-900">{log.usuario}</span>
              <span className="px-2 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">
                {log.accion}
              </span>
            </div>
            <p className="text-sm text-zinc-600 mb-1">{log.detalles || "Sin detalles"}</p>
            <div className="flex flex-wrap justify-between text-xs text-zinc-400">
              <span>IP: {log.ip || "-"}</span>
              <span>{log.fechaHora ? new Date(log.fechaHora).toLocaleString() : "-"}</span>
            </div>
          </div>
        ))}
        {logs.length === 0 && (
          <div className="rounded-xl bg-yellow-50 border border-yellow-200 p-6 text-center">
            <p className="text-yellow-700">No hay registros de auditoría</p>
          </div>
        )}
      </div>
    </div>
  );
}